From d20f94b952e9ad9b961deed17710dfdd2d87a2a7 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Sun, 26 Jul 2026 16:36:04 +0000
Subject: [PATCH] fix: hints available throughout the free-text phase, not just
 after it
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Pairs with the backend patch of the same name. Hints are now visible and
usable the entire time the free-text field is showing — not gated behind
exhausting all 4 tries. Only the multiple-choice options themselves stay
hidden until then, exactly like before.

- checkExerciseTextAnswer/checkContestTextAnswer now send the number of
  hints currently revealed, so a correct free-text guess after viewing
  hints is scored with the same reduced XP a QCM submission would give —
  no more automatic full-XP regardless of hint usage.
- Removed the incorrect helper copy implying hints unlock later.
---
 lib/core/api/api_client.dart                              | 8 ++++----
 lib/features/contests/presentation/concours_screen.dart   | 6 +++---
 lib/features/exercises/presentation/exercises_screen.dart | 6 +++---
 3 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/lib/core/api/api_client.dart b/lib/core/api/api_client.dart
index c668c65..74e91a5 100644
--- a/lib/core/api/api_client.dart
+++ b/lib/core/api/api_client.dart
@@ -148,8 +148,8 @@ class ApiClient {
 
   // Free-text guess, checked before the multiple-choice options are ever
   // revealed. Returns {correct: false} or {correct: true, xpEarned, solution}.
-  static Future<Map<String, dynamic>> checkExerciseTextAnswer(String exerciseId, String text) async {
-    final res = await _dio.post('/exercises/$exerciseId/check-answer', data: {'text': text});
+  static Future<Map<String, dynamic>> checkExerciseTextAnswer(String exerciseId, String text, int hintsUsed) async {
+    final res = await _dio.post('/exercises/$exerciseId/check-answer', data: {'text': text, 'hintsUsed': hintsUsed});
     return res.data;
   }
 
@@ -197,10 +197,10 @@ static Future<Map<String, dynamic>> submitContestAnswer(
 }
 
 static Future<Map<String, dynamic>> checkContestTextAnswer(
-  String sessionId, String questionId, String text) async {
+  String sessionId, String questionId, String text, int hintsUsed) async {
   final res = await _dio.post(
     '/contests/sessions/$sessionId/questions/$questionId/check-answer',
-    data: {'text': text},
+    data: {'text': text, 'hintsUsed': hintsUsed},
   );
   return res.data;
 }
diff --git a/lib/features/contests/presentation/concours_screen.dart b/lib/features/contests/presentation/concours_screen.dart
