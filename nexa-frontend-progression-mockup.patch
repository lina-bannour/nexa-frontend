+  ({String name, int xp, String icon, Color color}) _currentLevel(int xp) {
+    var current = _levels.first;
+    for (final l in _levels) {
+      if (xp >= l.xp) current = l;
+    }
+    return current;
+  }
+
+  ({String name, int xp, String icon, Color color})? _nextLevel(int xp) {
+    for (final l in _levels) {
+      if (xp < l.xp) return l;
+    }
+    return null;
+  }
